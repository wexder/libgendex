{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "persistence", "config"],
  "properties": {
    "replicaCount": { "type": "integer", "enum": [1] },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["data", "library"],
      "properties": {
        "data": { "$ref": "#/definitions/storage" },
        "library": {
          "allOf": [{ "$ref": "#/definitions/storage" }],
          "properties": {
            "nfs": {
              "type": "object",
              "required": ["enabled", "server", "path", "readOnly"],
              "properties": {
                "enabled": { "type": "boolean" },
                "server": { "type": "string" },
                "path": { "type": "string" },
                "readOnly": { "type": "boolean" }
              }
            }
          },
          "if": {
            "required": ["nfs"],
            "properties": {
              "nfs": {
                "required": ["enabled"],
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          "then": {
            "properties": {
              "existingClaim": { "maxLength": 0 },
              "nfs": {
                "properties": {
                  "server": { "minLength": 1 },
                  "path": { "pattern": "^/" }
                }
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "toml": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "imagePullSecrets": { "type": "array" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
  },
  "definitions": {
    "storage": {
      "type": "object",
      "required": ["enabled", "existingClaim", "size", "retain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "size": { "type": "string", "minLength": 1 },
        "retain": { "type": "boolean" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
        }
      }
    }
  }
}
